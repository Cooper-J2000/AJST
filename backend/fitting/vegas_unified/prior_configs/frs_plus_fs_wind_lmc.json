{
  "description": "正反激波对+独立正向激波 FS+RS(pair)+FS (top-hat, wind 星风介质, 宿主消光 LMC, on-axis); 双成分共用介质参数, 走自定义 MCMC 外壳",
  "model": "frs_plus_fs",
  "fit_engine": "custom",
  "jet": "tophat",
  "medium": "wind",
  "extinction": "lmc",
  "params": [
    {"name": "theta_c", "lower": 0.01, "upper": 0.5, "scale": "log"},
    {"name": "E_iso", "lower": 1e51, "upper": 1e55, "scale": "log"},
    {"name": "Gamma0", "lower": 50, "upper": 1000, "scale": "log"},
    {"name": "tau", "lower": 0.1, "upper": 10000, "scale": "log"},
    {"name": "theta_v", "lower": 0, "upper": 0, "scale": "fixed"},
    {"name": "p", "lower": 2.1, "upper": 2.9, "scale": "linear"},
    {"name": "eps_e", "lower": 0.001, "upper": 0.5, "scale": "log"},
    {"name": "eps_B", "lower": 1e-6, "upper": 0.1, "scale": "log"},
    {"name": "p_r", "lower": 2.1, "upper": 2.9, "scale": "linear"},
    {"name": "eps_e_r", "lower": 0.001, "upper": 0.5, "scale": "log"},
    {"name": "eps_B_r", "lower": 1e-6, "upper": 0.1, "scale": "log"},
    {"name": "theta_c2", "lower": 0.01, "upper": 0.5, "scale": "log"},
    {"name": "E_iso2", "lower": 1e51, "upper": 1e55, "scale": "log"},
    {"name": "Gamma02", "lower": 30, "upper": 1000, "scale": "log"},
    {"name": "p2", "lower": 2.1, "upper": 2.9, "scale": "linear"},
    {"name": "eps_e2", "lower": 0.001, "upper": 0.5, "scale": "log"},
    {"name": "eps_B2", "lower": 1e-6, "upper": 0.1, "scale": "log"},
    {"name": "A_star", "lower": 0.001, "upper": 100, "scale": "log"},
    {"name": "A_V", "lower": 0, "upper": 2, "scale": "linear"}
  ]
}
